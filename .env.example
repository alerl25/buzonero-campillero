# Variables de una instalación de Buzonero Campillero. NO rellenes este fichero a mano:
# `node scripts/configurar.mjs` las genera todas en `configuracion.env`. Ver INSTALAR.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BZ_URL=https://tu-app.vercel.app
BZ_CUENTAS=[{"k":"yo","email":"tu@gmail.com","nombre":"Personal","ini":"TU","env":"RT_ANCLA","entrar":true}]
BZ_ANCLA=yo
RT_ANCLA=
SESSION_SECRET=
TOKEN_KEY=
APP_PASSWORD_HASH=
VAPID_PUBLIC=
VAPID_PRIVATE=
VIGIA_KEY=
# opcionales
MCP_KEY_HASH=
BZ_ENTRAR=
# WhatsApp de solo lectura con Zernio (https://zernio.com): la clave de API. Sin ella, «WhatsApp» no sale en la barra lateral.
ZERNIO_API_KEY=
# CRM externo, solo lectura (opcional): una funcion «crm» que responde { ok, data: [contactos] } a { accion: "listar" } con la cabecera x-clave
CRM_EXT_URL=
CRM_EXT_CLAVE=
CRM_EXT_NOMBRE=
CRM_EXT_PANEL=
# Correos (separados por comas) cuyos dispositivos solo reciben los avisos del CRM externo (opcional; ver CHANGELOG 1.19.3)
BZ_AVISOS_LEADS=
# Quita una sola vez los dispositivos de avisos dados de alta desde esta fecha ISO sin identificar (opcional; ver CHANGELOG 1.20.1)
BZ_PURGA_PUSH_DESDE=
